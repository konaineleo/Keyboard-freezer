<Window x:Class="KeyboardTouchpadLock.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard &amp; Touchpad Lock — Settings"
        Height="560" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FAFAFA"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="RowLabel">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button" x:Key="HotkeyButton">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#0067C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource HotkeyButton}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" FontSize="20" FontWeight="Bold" Foreground="#212121"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <StackPanel>

                <TextBlock Text="Global Shortcuts" Style="{StaticResource SectionHeader}"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Toggle Keyboard Lock" Style="{StaticResource RowLabel}"/>
                    <Button x:Name="KeyboardHotkeyButton" Grid.Row="0" Grid.Column="1" Style="{StaticResource HotkeyButton}"
                            Content="Ctrl + Alt + 1" Click="HotkeyButton_Click" Tag="Keyboard"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Toggle Touchpad Lock" Style="{StaticResource RowLabel}"/>
                    <Button x:Name="TouchpadHotkeyButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource HotkeyButton}"
                            Content="Ctrl + Alt + 2" Click="HotkeyButton_Click" Tag="Touchpad"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Toggle Keyboard + Touchpad Lock" Style="{StaticResource RowLabel}"/>
                    <Button x:Name="BothHotkeyButton" Grid.Row="2" Grid.Column="1" Style="{StaticResource HotkeyButton}"
                            Content="Ctrl + Alt + 3" Click="HotkeyButton_Click" Tag="Both"/>
                </Grid>
                <TextBlock Text="Click a shortcut, then press the new key combination." FontSize="11" Foreground="#757575" Margin="0,4,0,0"/>

                <TextBlock Text="Startup" Style="{StaticResource SectionHeader}"/>
                <CheckBox x:Name="LaunchAtStartupCheck" Content="Launch at Windows startup" FontSize="12.5" Checked="AnySetting_Changed" Unchecked="AnySetting_Changed"/>
                <CheckBox x:Name="AlwaysAdminCheck" Content="Always run as administrator (avoids repeated UAC prompts for touchpad lock)" FontSize="12.5" Margin="0,8,0,0" Checked="AnySetting_Changed" Unchecked="AnySetting_Changed" TextWrapping="Wrap" Width="400"/>

                <TextBlock Text="Floating Indicator" Style="{StaticResource SectionHeader}"/>
                <CheckBox x:Name="ShowIndicatorCheck" Content="Show floating status indicator" FontSize="12.5" Checked="AnySetting_Changed" Unchecked="AnySetting_Changed"/>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Widget size" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="SizeSlider" Grid.Column="1" Minimum="32" Maximum="40" Value="36"
                            ValueChanged="AnySetting_Changed" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <TextBlock Grid.Column="2" Text="{Binding ElementName=SizeSlider, Path=Value, StringFormat={}{0:0}px}" Style="{StaticResource RowLabel}"/>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Opacity" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.8" Maximum="0.9" Value="0.85"
                            ValueChanged="AnySetting_Changed"/>
                    <TextBlock Grid.Column="2" Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:P0}}" Style="{StaticResource RowLabel}"/>
                </Grid>

                <CheckBox x:Name="AnimationsCheck" Content="Enable smooth transition animations" FontSize="12.5" Margin="0,14,0,0" Checked="AnySetting_Changed" Unchecked="AnySetting_Changed"/>

                <Button Content="Reset widget position to default corner" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left" Margin="0,14,0,0" Click="ResetPosition_Click"/>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Reset All to Defaults" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left" Click="ResetAll_Click"/>
            <Button Grid.Column="1" Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Grid.Column="2" Content="Save" Style="{StaticResource PrimaryButton}" Width="90" Click="Save_Click"/>
        </Grid>
    </Grid>
</Window>

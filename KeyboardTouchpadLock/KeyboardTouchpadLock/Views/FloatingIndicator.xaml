<Window x:Class="KeyboardTouchpadLock.Views.FloatingIndicator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input Status"
        Width="36" Height="36"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Grid x:Name="RootGrid"
          MouseLeftButtonDown="RootGrid_MouseLeftButtonDown"
          MouseRightButtonUp="RootGrid_MouseRightButtonUp">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1" CenterX="18" CenterY="18"/>
        </Grid.RenderTransform>

        <Ellipse x:Name="BackgroundCircle" Fill="#43A047" Opacity="0.85">
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.35" Color="Black"/>
            </Ellipse.Effect>
        </Ellipse>

        <TextBlock x:Name="IconText"
                   Text="&#x2713;"
                   FontFamily="Segoe UI Emoji"
                   FontSize="16"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"/>
    </Grid>
</Window>
